# WealthWise LLM Configuration
LLM_PROVIDER=groq                     # 'groq' or 'ollama'
LLM_BASE_URL=https://api.groq.com/openai/v1  # or http://localhost:11434/v1 for Ollama
LLM_API_KEY=gsk_your_groq_api_key_here       # 'ollama' or any string if using local Ollama
LLM_MODEL=llama-3.3-70b-versatile    # e.g., llama-3.3-70b-versatile, qwen2.5:7b, llama3.2:3b
LLM_TEMPERATURE=0.0                  # 0.0 for deterministic evaluation, 0.2 for chat
LLM_TOP_P=1.0
LLM_MAX_TOKENS=1024
MAX_AGENT_ITERATIONS=5
LOG_LEVEL=INFO

